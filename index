<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>บันไดงูมหาสนุก ตะลุยโลกสระเกิน</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;700;800&display=swap" rel="stylesheet">
<style>
/* ===== ตัวแปรสีและพื้นฐาน ===== */
:root{
  --blue:#4fc3f7; --pink:#ff6b9d; --yellow:#ffd54f; --purple:#8e6cf0; --green:#66bb6a;
  --ink:#2d2a4a; --white:#ffffff;
}
*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none !important}
body{
  font-family:'Sarabun','Leelawadee UI','Tahoma',sans-serif;
  color:var(--ink);
  min-height:100vh;
  background:linear-gradient(180deg,#8ee4ff 0%,#c9f1ff 50%,#fff6c9 100%);
  overflow-x:hidden;
}
/* ฉากหลังตกแต่ง: เมฆและดาวลอยไปมา */
.deco{position:fixed;pointer-events:none;opacity:.75;animation:float 6s ease-in-out infinite;z-index:0;user-select:none}
.deco.d1{top:6%;left:3%;font-size:46px}
.deco.d2{top:14%;right:6%;font-size:58px;animation-delay:1s}
.deco.d3{bottom:12%;left:5%;font-size:40px;animation-delay:2s}
.deco.d4{bottom:8%;right:4%;font-size:50px;animation-delay:.5s}
.deco.d5{top:45%;left:48%;font-size:28px;animation-delay:1.5s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

/* ===== หน้าจอ ===== */
#app{position:relative;z-index:1;min-height:100vh}
.screen{display:none;min-height:100vh;padding:24px 16px;align-items:center;justify-content:center;flex-direction:column}
.screen.active{display:flex}

/* ===== ปุ่ม ===== */
.btn{
  border:none;border-radius:999px;padding:12px 22px;font:inherit;font-weight:800;font-size:17px;
  cursor:pointer;color:#fff;box-shadow:0 5px 0 rgba(0,0,0,.18);transition:transform .08s,box-shadow .08s,opacity .2s;
  white-space:nowrap;
}
.btn:hover{filter:brightness(1.05)}
.btn:active{transform:translateY(3px);box-shadow:0 2px 0 rgba(0,0,0,.18)}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:0 5px 0 rgba(0,0,0,.1)}
.btn.big{font-size:21px;padding:14px 28px;min-width:230px}
.btn.small{font-size:15px;padding:9px 14px}
.btn.pink{background:var(--pink)}
.btn.blue{background:var(--blue);color:#0d3b57}
.btn.yellow{background:var(--yellow);color:#5a4300}
.btn.green{background:var(--green)}
.btn.purple{background:var(--purple)}
.btn.ghost{background:#fff;color:var(--ink)}
.row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;align-items:center}

/* ===== ใบการ์ด ===== */
.card{background:rgba(255,255,255,.92);border-radius:24px;padding:22px;box-shadow:0 10px 30px rgba(60,80,140,.18)}

/* ===== หน้าแรก ===== */
.hero{text-align:center;max-width:640px;width:100%}
.title{font-size:clamp(34px,7vw,64px);font-weight:800;color:#ff4f8b;text-shadow:3px 3px 0 #fff,6px 6px 0 #ffd54f;line-height:1.2}
.subtitle{font-size:clamp(24px,5vw,40px);font-weight:800;color:#6c4fd6;margin-top:6px;text-shadow:2px 2px 0 #fff}
.tagline{font-size:20px;margin:14px 0 4px;font-weight:700}
.hero-art{font-size:clamp(40px,8vw,64px);letter-spacing:10px;margin:14px 0 24px;animation:bounce 2.4s ease-in-out infinite}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.menu{display:flex;flex-direction:column;gap:14px;align-items:center}

/* ===== หน้าตั้งค่าผู้เล่น ===== */
.setup-card{max-width:560px;width:100%;text-align:center}
.setup-card h2{font-size:30px;color:#6c4fd6;margin-bottom:6px}
.setup-card p{margin-bottom:14px;font-weight:700}
.count-row{display:flex;gap:10px;justify-content:center;margin-bottom:16px;flex-wrap:wrap}
.cnt{border:3px solid #cfc3ff;background:#fff;border-radius:16px;padding:10px 18px;font:inherit;font-weight:800;font-size:18px;cursor:pointer;color:var(--ink)}
.cnt.on{background:var(--purple);color:#fff;border-color:var(--purple)}
.name-inputs{display:grid;gap:10px;margin-bottom:20px}
.name-field{display:flex;align-items:center;gap:10px;background:#f6f3ff;border-radius:16px;padding:8px 12px;border:2px solid #e2d9ff}
.name-field .av{font-size:26px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;border:2px solid #fff}
.name-field input{flex:1;border:none;background:transparent;font:inherit;font-size:18px;font-weight:700;color:var(--ink);outline:none;min-width:0}

/* ===== หน้าความรู้ ===== */
.know-wrap{max-width:980px;width:100%}
.page-title{font-size:clamp(26px,5vw,38px);text-align:center;color:#6c4fd6;margin-bottom:18px;text-shadow:2px 2px 0 #fff}
.know-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-bottom:22px}
.kcard{border-radius:24px;padding:20px;color:var(--ink);box-shadow:0 8px 20px rgba(60,80,140,.18)}
.kcard h3{font-size:22px;margin-bottom:8px}
.kcard p{font-size:17px;line-height:1.6}
.kcard.c1{background:#cdeeff}
.kcard.c2{background:#ffdcec}
.kcard.c3{background:#fff3b0}
.kcard.c4{background:#e6dbff}
.kcard.c5{background:#d6f5cf}
.kcard.c6{background:#ffe6c7}
table.sara{width:100%;border-collapse:collapse;margin-top:8px;background:#fff;border-radius:14px;overflow:hidden}
table.sara th,table.sara td{padding:8px;text-align:center;font-size:17px;border-bottom:1px solid #eee}
table.sara th{background:#8e6cf0;color:#fff}
.sara-glyph{font-size:30px;font-weight:800;color:#ff4f8b}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.chip{background:#fff;border-radius:999px;padding:6px 12px;font-weight:700;font-size:17px}

/* ===== หน้าเกม ===== */
.game-layout{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:18px;width:100%;max-width:1100px;align-items:start}
.board-area{display:flex;justify-content:center}
.board-wrap{
  position:relative;width:min(92vw,620px);aspect-ratio:1/1;border-radius:22px;overflow:hidden;
  background:#fff;border:6px solid #fff;box-shadow:0 14px 34px rgba(60,80,140,.28);
}
.board{position:absolute;inset:0;display:grid;grid-template-columns:repeat(10,1fr);grid-template-rows:repeat(10,1fr);z-index:1}
.cell{position:relative;border:1px solid rgba(255,255,255,.85);font-size:clamp(10px,1.5vw,14px);font-weight:800;color:#4a4670}
.cell .num{position:absolute;left:3px;top:0}
.cell .tag{position:absolute;right:2px;bottom:0;font-size:clamp(10px,1.6vw,16px)}
.overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2}
.tokens{position:absolute;inset:0;pointer-events:none;z-index:3}
.token{
  position:absolute;width:4.2%;aspect-ratio:1/1;border-radius:50%;display:grid;place-items:center;
  font-size:clamp(12px,2.2vw,20px);border:2px solid #fff;box-shadow:0 3px 6px rgba(0,0,0,.3);
  transition:left .28s ease,top .28s ease;
}

.side{display:flex;flex-direction:column;gap:14px}
.turn-card{text-align:center}
.turn-label{font-weight:700;color:#6c6a8a}
.turn-name{font-size:26px;font-weight:800;margin:4px 0 12px;color:#6c4fd6}
.dice-area{display:flex;justify-content:center;margin-bottom:12px}
.dice{
  width:96px;height:96px;background:#fff;border-radius:20px;padding:12px;
  display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);gap:4px;
  box-shadow:inset 0 -4px 0 #e5e0f5,0 8px 16px rgba(0,0,0,.2);border:2px solid #eee;
}
.pip{border-radius:50%;background:transparent}
.pip.on{background:#ff4d7d;box-shadow:inset -2px -2px 0 rgba(0,0,0,.2)}
.turn-hint{margin-top:10px;font-size:16px;font-weight:700;color:#6c6a8a;min-height:24px}
.side h3{font-size:20px;margin-bottom:10px;color:#6c4fd6}
.score-list{list-style:none;display:grid;gap:8px}
.score-item{display:grid;grid-template-columns:auto auto 1fr auto;gap:8px;align-items:center;background:#f6f3ff;border-radius:14px;padding:8px 10px;border-left:6px solid #ccc}
.score-item .rank{font-weight:800;font-size:18px;width:26px;text-align:center}
.score-item .av{font-size:20px}
.score-item .nm{font-weight:800;font-size:17px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.score-item .det{font-size:13px;color:#5f5a80}
.score-item .pts{font-weight:800;color:#c2185b;font-size:16px;text-align:right}
.score-item.active{background:#fff3c4;box-shadow:0 0 0 2px #ffd54f}

/* ===== ข้อความแจ้งเตือนกลางจอ ===== */
.banner{
  position:fixed;left:50%;top:18%;transform:translate(-50%,-50%) scale(.9);z-index:200;
  background:#fff;border-radius:22px;padding:16px 26px;font-size:clamp(18px,3.5vw,26px);font-weight:800;
  box-shadow:0 14px 34px rgba(0,0,0,.25);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;
  text-align:center;max-width:92vw;
}
.banner.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
.banner.up{border:4px solid var(--green);color:#2e7d32}
.banner.down{border:4px solid var(--pink);color:#c2185b}

/* ===== โมดัล ===== */
.modal{position:fixed;inset:0;background:rgba(40,30,80,.5);display:grid;place-items:center;z-index:100;padding:16px}
.modal-card{background:#fff;border-radius:26px;max-width:620px;width:100%;padding:24px;box-shadow:0 20px 50px rgba(0,0,0,.3);max-height:92vh;overflow:auto;position:relative}
.q-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.badge{padding:6px 14px;border-radius:999px;font-weight:800;font-size:15px;color:#fff}
.badge.l0{background:var(--green)}
.badge.l1{background:var(--blue);color:#0d3b57}
.badge.l2{background:var(--pink)}
.q-player{font-weight:800;color:#6c4fd6;font-size:17px}
.q-text{font-size:clamp(19px,3vw,23px);font-weight:700;line-height:1.6;margin-bottom:16px;white-space:pre-line}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.choice{
  background:#f4f1ff;border:3px solid #d9d0ff;border-radius:16px;padding:12px 14px;font:inherit;font-size:18px;
  font-weight:700;cursor:pointer;text-align:left;color:var(--ink);transition:transform .08s;
}
.choice:hover:not(:disabled){transform:translateY(-2px);background:#ece6ff}
.choice:disabled{cursor:default}
.choice .lab{display:inline-block;min-width:26px;color:#6c4fd6;font-weight:800}
.choice.right{background:#d6f5cf;border-color:var(--green)}
.choice.wrong{background:#ffd9e4;border-color:var(--pink)}
.feedback{margin-top:16px;text-align:center;background:#fbf9ff;border-radius:18px;padding:16px;border:2px dashed #cfc3ff}
.fb-title{font-size:24px;font-weight:800;margin-bottom:8px}
.fb-title.good{color:#2e7d32}
.fb-title.bad{color:#c2185b}
.fb-exp{font-size:17px;line-height:1.7;margin-bottom:14px;white-space:pre-line;text-align:left}
.close-x{position:absolute;top:10px;right:14px;border:none;background:transparent;font-size:26px;cursor:pointer;color:#888}

.how-list{padding-left:0;list-style:none;display:grid;gap:10px;font-size:18px;line-height:1.6}
.how-list li{background:#f6f3ff;border-radius:14px;padding:10px 14px}
.how-list b{color:#6c4fd6}

/* ===== หน้าชนะ ===== */
.win-card{max-width:560px;width:100%;text-align:center}
.trophy{font-size:80px;animation:bounce 1.6s ease-in-out infinite}
.win-title{font-size:clamp(24px,4.5vw,34px);color:#ff4f8b;margin:8px 0;text-shadow:2px 2px 0 #fff}
.win-name{font-size:22px;font-weight:800;margin-bottom:14px;color:#6c4fd6}
.win-card .score-list{margin:16px 0 22px;text-align:left}

/* ===== เอฟเฟกต์ ===== */
#fx{position:fixed;inset:0;pointer-events:none;z-index:300;overflow:hidden}
.conf{position:absolute;top:-20px;width:10px;height:16px;border-radius:3px;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg)}}
.spark{position:absolute;font-size:28px;animation:pop 1s ease-out forwards}
@keyframes pop{0%{transform:scale(.2) rotate(0);opacity:1}100%{transform:scale(1.4) rotate(160deg) translateY(-40px);opacity:0}}

#toast{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#2d2a4a;color:#fff;
  padding:10px 18px;border-radius:14px;font-weight:700;z-index:250;opacity:0;transition:opacity .3s;pointer-events:none;
}
#toast.show{opacity:1}

/* ===== ปรับขนาดสำหรับแท็บเล็ตและมือถือ ===== */
@media (max-width:860px){
  .game-layout{grid-template-columns:1fr;justify-items:center}
  .side{width:min(92vw,620px)}
  .turn-card{display:grid;grid-template-columns:auto 1fr;gap:12px;text-align:left;align-items:center}
  .turn-card .dice-area{margin:0}
  .turn-card .turn-hint,.turn-card .btn{grid-column:auto}
}
@media (max-width:560px){
  .choices{grid-template-columns:1fr}
  .btn.big{min-width:0;width:100%}
  .turn-card{grid-template-columns:1fr;text-align:center}
  .turn-card .dice-area{justify-content:center}
}
</style>
</head>
<body>

<!-- ฉากหลังตกแต่ง -->
<div class="deco d1">☁️</div>
<div class="deco d2">🌈</div>
<div class="deco d3">⭐</div>
<div class="deco d4">🌳</div>
<div class="deco d5">✨</div>

<div id="app">

  <!-- ===== หน้าแรก ===== -->
  <section id="screen-start" class="screen active">
    <div class="hero">
      <h1 class="title">บันไดงูมหาสนุก</h1>
      <h2 class="subtitle">ตะลุยโลกสระเกิน</h2>
      <p class="tagline">เรียนรู้ภาษาไทยไปกับครูจองซ่า</p>
      <div class="hero-art">🐍 🪜 🎲 🧒</div>
      <div class="menu">
        <button class="btn big pink" id="btnPlay">▶ เริ่มเล่นเกม</button>
        <button class="btn big blue" id="btnHowStart">📖 วิธีเล่น</button>
        <button class="btn big yellow" id="btnKnowStart">💡 ความรู้เรื่องสระเกิน</button>
        <button class="btn big green" id="btnSoundStart">🔊 เสียง: เปิด</button>
      </div>
    </div>
  </section>

  <!-- ===== ตั้งค่าผู้เล่น ===== -->
  <section id="screen-setup" class="screen">
    <div class="card setup-card">
      <h2>ตั้งค่าผู้เล่น</h2>
      <p>เลือกจำนวนผู้เล่น 2–4 คน แล้วกรอกชื่อ</p>
      <div class="count-row" id="countRow">
        <button class="cnt" data-n="2">2 คน</button>
        <button class="cnt on" data-n="3">3 คน</button>
        <button class="cnt" data-n="4">4 คน</button>
      </div>
      <div class="name-inputs" id="nameInputs"></div>
      <div class="row">
        <button class="btn ghost" id="btnSetupBack">⬅ กลับ</button>
        <button class="btn big pink" id="btnStart">เริ่มเกม ▶</button>
      </div>
    </div>
  </section>

  <!-- ===== ความรู้เรื่องสระเกิน ===== -->
  <section id="screen-know" class="screen">
    <div class="know-wrap">
      <h2 class="page-title">💡 ความรู้เรื่องสระเกิน</h2>
      <div class="know-grid">
        <div class="kcard c1">
          <h3>🌟 สระเกินคืออะไร?</h3>
          <p>สระเกินคือกลุ่มรูปสระพิเศษ ที่พบไม่บ่อยในคำไทยทั่วไป มักพบในคำที่รับมาจากภาษาบาลีและสันสกฤต</p>
        </div>
        <div class="kcard c2">
          <h3>🔤 สระเกิน 4 รูป</h3>
          <table class="sara">
            <tr><th>รูปสระ</th><th>ออกเสียงในปัจจุบัน</th></tr>
            <tr><td class="sara-glyph">ฤ</td><td>รึ</td></tr>
            <tr><td class="sara-glyph">ฤๅ</td><td>รือ</td></tr>
            <tr><td class="sara-glyph">ฦ</td><td>ลึ</td></tr>
            <tr><td class="sara-glyph">ฦๅ</td><td>ลือ</td></tr>
          </table>
        </div>
        <div class="kcard c3">
          <h3>📝 ตัวอย่างคำ</h3>
          <div class="chips">
            <span class="chip">ฤดู (ฤ)</span>
            <span class="chip">ฤทธิ์ (ฤ)</span>
            <span class="chip">ฤกษ์ (ฤ)</span>
            <span class="chip">กฤษณา (ฤ)</span>
            <span class="chip">ฤๅษี (ฤๅ)</span>
          </div>
          <p style="margin-top:10px">สระ ฦ และ ฦๅ พบน้อยมาก ส่วนใหญ่พบในคำเก่า</p>
        </div>
        <div class="kcard c4">
          <h3>👀 วิธีจำง่าย ๆ</h3>
          <p>สังเกต <b>ๅ</b> (ไม้ไต่คู้) ที่อยู่ท้ายรูป ถ้ามี ๅ แสดงว่าเป็น <b>ฤๅ</b> หรือ <b>ฦๅ</b> ถ้าไม่มี ๅ แสดงว่าเป็น <b>ฤ</b> หรือ <b>ฦ</b></p>
        </div>
        <div class="kcard c5">
          <h3>🧩 สระที่ไม่ใช่สระเกิน</h3>
          <p>ะ &nbsp; า &nbsp; ิ &nbsp; ี &nbsp; ุ &nbsp; ู &nbsp; เ- &nbsp; แ- &nbsp; โ- &nbsp; ไ- &nbsp; ใ- ล้วนเป็นสระที่ใช้ทั่วไป ไม่ใช่สระเกิน</p>
        </div>
        <div class="kcard c6">
          <h3>📌 หมายเหตุสำหรับครู</h3>
          <p>การจัดกลุ่มสระเกินอาจแตกต่างกันตามตำรา เนื้อหานี้ใช้แนวทางที่พบได้ทั่วไปในระดับประถมศึกษา</p>
        </div>
      </div>
      <div class="row">
        <button class="btn big blue" id="btnKnowBack">⬅ กลับ</button>
      </div>
    </div>
  </section>

  <!-- ===== หน้าเกมหลัก ===== -->
  <section id="screen-game" class="screen">
    <div class="game-layout">
      <div class="board-area">
        <div class="board-wrap" id="boardWrap">
          <div class="board" id="board"></div>
          <svg class="overlay" id="overlay" viewBox="0 0 100 100" preserveAspectRatio="none"></svg>
          <div class="tokens" id="tokens"></div>
        </div>
      </div>
      <aside class="side">
        <div class="card turn-card">
          <div>
            <div class="turn-label">ตาของ</div>
            <div class="turn-name" id="turnName">-</div>
            <div class="dice-area"><div class="dice" id="dice"></div></div>
          </div>
          <div>
            <button class="btn big pink" id="btnRoll">🎲 ทอยลูกเต๋า</button>
            <div class="turn-hint" id="turnHint">ทอยลูกเต๋าเพื่อเริ่มตอบคำถาม</div>
          </div>
        </div>
        <div class="card">
          <h3>🏆 ลำดับผู้เล่น</h3>
          <ol class="score-list" id="scoreList"></ol>
        </div>
        <div class="row">
          <button class="btn small blue" id="btnHowGame">📖 วิธีเล่น</button>
          <button class="btn small yellow" id="btnKnowGame">💡 ความรู้</button>
          <button class="btn small green" id="btnSoundGame">🔊 เสียง</button>
          <button class="btn small ghost" id="btnNewGame">🔄 เริ่มเกมใหม่</button>
        </div>
      </aside>
