/* ---------- ตัวช่วยทั่วไป ---------- */
function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}
const $ = id => document.getElementById(id);

/* แปลงลำดับช่อง 1–100 เป็นตำแหน่ง col (0–9) และ row (0 คือแถวบนสุด)
   แถวล่างสุดเริ่มจาก 1 ไปทางขวา แถวถัดไปเดินกลับทางซ้าย (แบบงู) */
function cellPos(n){
  const i = n-1;
  const r = Math.floor(i/10);          // แถวนับจากล่าง (0 = ล่างสุด)
  const c = i % 10;
  const col = (r % 2 === 0) ? c : 9-c;
  const row = 9 - r;                   // แปลงให้ 0 = บนสุด เพื่อใช้กับ CSS grid
  return {col, row};
}
function center(n){
  const {col,row} = cellPos(n);
  return {x: col*10+5, y: row*10+5};
}

/* ---------- เสียง (Web Audio API) ---------- */
let audioCtx = null;
let soundOn = true;
function tone(freq, dur=0.15, type='sine', vol=0.15, when=0){
  if(!soundOn) return;
  try{
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    const t0 = audioCtx.currentTime + when;
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = type;
    o.frequency.value = freq;
    g.gain.setValueAtTime(vol, t0);
    g.gain.exponentialRampToValueAtTime(0.001, t0+dur);
    o.connect(g).connect(audioCtx.destination);
    o.start(t0);
    o.stop(t0+dur+0.02);
  }catch(e){ /* ถ้าเบราว์เซอร์ไม่รองรับเสียงให้ข้ามไป */ }
}
