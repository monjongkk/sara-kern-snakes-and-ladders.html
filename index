/* ใช้ข้อมูลดิบแปลงเป็นอ็อบเจกต์ */
const QUESTIONS = RAW_QUESTIONS.map(([level,q,c,a,e])=>({level,q,c,a,e}));

/* สุ่มคำถามแบบไม่ซ้ำ: เมื่อใช้ครบแล้วจึงสุ่มชุดใหม่ */
function refillQueue(){
  const pick = lv => shuffle(QUESTIONS.filter(x=>x.level===lv));
  queue = [...pick(0), ...pick(1), ...pick(2)];
}
function nextQuestion(){
  if(queue.length === 0) refillQueue();
  return queue.shift();
}

function currentPlayer(){ return state.players[state.turn]; }

/* ---------- สร้างกระดาน ---------- */
function buildBoard(){
  const b = $('board');
  b.innerHTML = '';
  for(let n=1;n<=100;n++){
    const {col,row} = cellPos(n);
    const d = document.createElement('div');
    d.className = 'cell';
    d.style.gridColumn = (col+1);
    d.style.gridRow = (row+1);
    d.style.background = CELL_COLORS[(row+col)%CELL_COLORS.length];
    let html = `<span class="num">${n}</span>`;
    if(n===1)   html += `<span class="tag">🚩</span>`;
    if(n===100) html += `<span class="tag">🏁</span>`;
    d.innerHTML = html;
    b.appendChild(d);
  }
}

/* วาดบันไดและงูด้วย SVG (ใช้พิกัด 0–100 ตรงกับกระดาน) */
function drawLadder(a, b){
  const dx = b.x-a.x, dy = b.y-a.y, len = Math.hypot(dx,dy);
  const ux = dx/len, uy = dy/len;
  const px = -uy*2.2, py = ux*2.2;   // ระยะห่างของรางบันได
  let s = '';
  s += `<line x1="${a.x+px}" y1="${a.y+py}" x2="${b.x+px}" y2="${b.y+py}" stroke="#8d5524" stroke-width="1.1" stroke-linecap="round" opacity=".9"/>`;
  s += `<line x1="${a.x-px}" y1="${a.y-py}" x2="${b.x-px}" y2="${b.y-py}" stroke="#8d5524" stroke-width="1.1" stroke-linecap="round" opacity=".9"/>`;
  for(let t=0.12; t<=0.9; t+=0.13){
    const cx = a.x+dx*t, cy = a.y+dy*t;
    s += `<line x1="${cx+px}" y1="${cy+py}" x2="${cx-px}" y2="${cy-py}" stroke="#d9a55b" stroke-width=".9" opacity=".95"/>`;
  }
  return s;
}
function drawSnake(h, t, color){
  const dx = t.x-h.x, dy = t.y-h.y, len = Math.hypot(dx,dy);
  const ux = dx/len, uy = dy/len;
  const nx = -uy, ny = ux;
  const N = 28;
  let d = '';
  for(let i=0;i<=N;i++){
    const u = i/N;
    const wave = Math.sin(u*Math.PI*4) * 3.2;
    const x = h.x + dx*u + nx*wave;
    const y = h.y + dy*u + ny*wave;
    d += (i===0 ? 'M' : 'L') + x.toFixed(2) + ' ' + y.toFixed(2) + ' ';
  }
  let s = `<path d="${d}" fill="none" stroke="${color}" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" opacity=".95"/>`;
  s += `<path d="${d}" fill="none" stroke="#fff" stroke-width=".7" stroke-linecap="round" stroke-dasharray="2 3" opacity=".6"/>`;
  // หัวงู
  s += `<circle cx="${h.x}" cy="${h.y}" r="2.9" fill="${color}"/>`;
  s += `<circle cx="${h.x-1}" cy="${h.y-0.8}" r=".6" fill="#fff"/>`;
  s += `<circle cx="${h.x+1}" cy="${h.y-0.8}" r=".6" fill="#fff"/>`;
  s += `<circle cx="${t.x}" cy="${t.y}" r="1.4" fill="${color}" opacity=".8"/>`;
  return s;
}
function drawOverlay(){
  let html = '';
  Object.entries(LADDERS).forEach(([from,to])=>{
    html += drawLadder(center(+from), center(+to));
  });
  Object.entries(SNAKES).forEach(([head,tail],i)=>{
    html += drawSnake(center(+head), center(+tail), SNAKE_COLORS[i%SNAKE_COLORS.length]);
  });
  $('overlay').innerHTML = html;
}

/* ---------- ตัวละครผู้เล่น ---------- */
function buildTokens(){
  const wrap = $('tokens');
  wrap.innerHTML = '';
  state.players.forEach((p,i)=>{
    const t = document.createElement('div');
    t.className = 'token';
    t.style.background = p.color;
    t.textContent = p.avatar;
    t.title = p.name;
    wrap.appendChild(t);
    p.el = t;
  });
}
function renderTokens(){
  state.players.forEach((p,i)=>{
    const {col,row} = cellPos(p.pos);
    const [ox,oy] = OFFSETS[i];
    p.el.style.left = (col*10 + 5 - 2.1 + ox) + '%';
    p.el.style.top  = (row*10 + 5 - 2.1 + oy) + '%';
  });
}

/* ---------- ลูกเต๋า ---------- */
function setDice(v){
  const d = $('dice');
  d.innerHTML = '';
  for(let i=0;i<9;i++){
    const s = document.createElement('span');
    s.className = 'pip' + (PIPS[v].includes(i) ? ' on' : '');
    d.appendChild(s);
  }
}

/* ---------- แสดงผลด้านข้าง ---------- */
function renderSide(){
  const list = $('scoreList');
  list.innerHTML = '';
  const order = state.players
    .map((p,i)=>({p,i}))
    .sort((a,b)=> b.p.pos-a.p.pos || b.p.score-a.p.score || a.i-b.i);
  order.forEach((o,rank)=>{
    const p = o.p;
    const li = document.createElement('li');
    li.className = 'score-item' + (!state.over && o.i===state.turn ? ' active' : '');
    li.style.borderLeftColor = p.color;
    li.innerHTML = `
      <span class="rank">${rank+1}</span>
      <span class="av">${p.avatar}</span>
      <div><div class="nm"></div><div class="det">ช่อง ${p.pos} · ✅ ${p.right} · ❌ ${p.wrong}</div></div>
      <span class="pts">⭐ ${p.score}</span>`;
    li.querySelector('.nm').textContent = p.name;
    list.appendChild(li);
  });
}
function updateTurn(){
  if(!state) return;
  const p = currentPlayer();
  $('turnName').textContent = `${p.avatar} ${p.name}`;
  $('btnRoll').disabled = state.busy || state.over;
  if(state.over){
    $('turnHint').textContent = 'เกมจบแล้ว';
  } else if(state.busy){
    $('turnHint').textContent = 'กำลังดำเนินการ... รอสักครู่';
  } else {
    $('turnHint').textContent = `ถึงตาของ ${p.name} ทอยลูกเต๋าได้เลย`;
  }
}

/* ---------- เริ่มเกม ---------- */
function startGame(names){
  state = {
    players: names.map((name,i)=>({
      name, color: PLAYER_COLORS[i], avatar: AVATARS[i],
      pos: 1, score: 0, right: 0, wrong: 0, el: null
    })),
    turn: 0,
    busy: false,
    over: false,
    cur: null,
    dice: 1
  };
  savedNames = names.slice();
  refillQueue();
  buildTokens();
  renderTokens();
  setDice(1);
  renderSide();
  updateTurn();
  showScreen('game');
}

/* ---------- ทอยลูกเต๋า ---------- */
function onRoll(){
  if(!state || state.busy || state.over) return;
  state.busy = true;
  updateTurn();
  const finalValue = 1 + Math.floor(Math.random()*6);
  sfxDice();
  let k = 0;
  const iv = setInterval(()=>{
    setDice(1 + Math.floor(Math.random()*6));
    k++;
    if(k >= 10){
      clearInterval(iv);
      setDice(finalValue);
      state.dice = finalValue;
      setTimeout(()=>askQuestion(finalValue), 450);
    }
  }, 75);
}

/* ---------- คำถาม ---------- */
const LABEL_TEXT = ['ก','ข','ค','ง'];
function askQuestion(dice){
  if(!state || state.over) return;
  const p = currentPlayer();
  const q = nextQuestion();
  const order = shuffle([0,1,2,3]);
  const choices = order.map(i=>({text:q.c[i], ok: i===q.a}));
  state.cur = {q, dice, choices, answered:false};

  const lv = $('qLevel');
  lv.textContent = LEVEL_NAMES[q.level];
  lv.className = 'badge l' + q.level;
  $('qPlayer').textContent = `${p.avatar} ${p.name} ตอบเพื่อเดินหน้า ${dice} ช่อง`;
  $('qText').textContent = q.q;

  const box = $('qChoices');
  box.innerHTML = '';
  choices.forEach((c,idx)=>{
    const b = document.createElement('button');
    b.className = 'choice';
    const lab = document.createElement('span');
    lab.className = 'lab';
    lab.textContent = CHOICE_LABELS[idx];
    b.appendChild(lab);
    b.appendChild(document.createTextNode(' ' + c.text));
    b.addEventListener('click', ()=>chooseAnswer(idx));
    box.appendChild(b);
  });

  $('qFeedback').hidden = true;
  $('qModal').hidden = false;
}

function chooseAnswer(idx){
  const cur = state.cur;
  if(!cur || cur.answered) return;
  cur.answered = true;
  const p = currentPlayer();
  const buttons = $('qChoices').querySelectorAll('button');
  buttons.forEach((b,i)=>{
    b.disabled = true;
    if(cur.choices[i].ok) b.classList.add('right');
  });
  const picked = cur.choices[idx];
  if(!picked.ok) buttons[idx].classList.add('wrong');

  // หาป้ายและข้อความของคำตอบที่ถูก เพื่อใช้แสดงเฉลย
  const correctIdx = cur.choices.findIndex(c=>c.ok);
  const correctLabel = CHOICE_LABELS[correctIdx];
  const correctText = cur.choices[correctIdx].text;

  const title = $('qFbTitle');
  const exp = $('qFbExp');
  const next = $('qNext');

  if(picked.ok){
    p.score += 10;
    p.right += 1;
    sfxGood();
    sparkle();
    title.textContent = 'เก่งมาก! ถูกต้องแล้ว ⭐';
    title.className = 'fb-title good';
    exp.textContent = `เฉลย: ${correctLabel} ${correctText}\n${cur.q.e}\n\n+10 คะแนน`;
    next.textContent = `🎲 เดินหน้า ${cur.dice} ช่อง`;
    next.onclick = ()=>{
      $('qModal').hidden = true;
      movePlayer(p, cur.dice);
    };
  } else {
    p.wrong += 1;
    sfxBad();
    title.textContent = 'ไม่เป็นไรนะ ลองเรียนรู้ไปด้วยกัน 💖';
    title.className = 'fb-title bad';
    exp.textContent = `เฉลย: ${correctLabel} ${correctText}\n${cur.q.e}\n\nรอบนี้ยังไม่เดินหน้า`;
    next.textContent = 'ผู้เล่นคนถัดไป ▶';
    next.onclick = ()=>{
      $('qModal').hidden = true;
      endTurn();
    };
  }
  $('qFeedback').hidden = false;
  renderSide();
}

/* ---------- เดินตัวละครทีละช่อง ---------- */
function movePlayer(p, steps){
  let left = steps;
  const tick = ()=>{
    if(left > 0 && p.pos < 100){
      p.pos += 1;
      left -= 1;
      sfxTick();
      renderTokens();
      renderSide();
      setTimeout(tick, 280);
    } else {
      setTimeout(()=>afterMove(p), 250);
    }
  };
  tick();
}

/* ---------- ตรวจบันไดและงูหลังเดิน ---------- */
function afterMove(p){
  if(p.pos === 100){
    return winGame(p);
  }
  const isLadder = LADDERS[p.pos] !== undefined;
  const isSnake  = SNAKES[p.pos] !== undefined;
  if(!isLadder && !isSnake){
    return endTurn();
  }
  const from = p.pos;
  const to = isLadder ? LADDERS[from] : SNAKES[from];
  if(isLadder){
    banner(`🪜 ขึ้นบันได! ${p.name} จากช่อง ${from} ไปช่อง ${to}`, 'up');
    sfxUp();
  } else {
    banner(`🐍 ตกงู! ${p.name} จากช่อง ${from} ลงไปช่อง ${to}`, 'down');
    sfxDown();
  }
  setTimeout(()=>{
    p.pos = to;
    renderTokens();
    renderSide();
    setTimeout(()=>{
      if(p.pos === 100) winGame(p);
      else endTurn();
    }, 600);
  }, 1300);
}

/* ---------- จบตาและสลับผู้เล่น ---------- */
function endTurn(){
  $('qModal').hidden = true;
  state.cur = null;
  state.busy = false;
  state.turn = (state.turn + 1) % state.players.length;
  renderSide();
  updateTurn();
}

/* ---------- ชนะเกม ---------- */
function winGame(p){
  state.over = true;
  state.busy = false;
  state.cur = null;
  $('qModal').hidden = true;
  renderTokens();
  renderSide();
  updateTurn();
  sfxWin();
  confetti();
  setTimeout(()=>{
    $('winName').textContent = `🎉 ผู้ชนะคือ ${p.avatar} ${p.name} 🎉`;
    const list = $('winList');
    list.innerHTML = '';
    state.players
      .map((pl,i)=>({pl,i}))
      .sort((a,b)=> b.pl.pos-a.pl.pos || b.pl.score-a.pl.score || a.i-b.i)
      .forEach((o,rank)=>{
        const pl = o.pl;
        const li = document.createElement('li');
        li.className = 'score-item';
        li.style.borderLeftColor = pl.color;
        li.innerHTML = `
          <span class="rank">${rank+1}</span>
          <span class="av">${pl.avatar}</span>
          <div><div class="nm"></div><div class="det">ช่อง ${pl.pos} · ✅ ${pl.right} · ❌ ${pl.wrong}</div></div>
          <span class="pts">⭐ ${pl.score}</span>`;
        li.querySelector('.nm').textContent = pl.name;
        list.appendChild(li);
      });
    showScreen('win');
  }, 1600);
}

/* ---------- หน้าตั้งค่าผู้เล่น ---------- */
let playerCount = 3;
function renderNameInputs(){
  const wrap = $('nameInputs');
  // เก็บชื่อที่พิมพ์ไว้ก่อน แล้วค่อยสร้างช่องใหม่
  const current = [...wrap.querySelectorAll('input')].map(i=>i.value);
  current.forEach((v,i)=>{ if(v.trim()) savedNames[i] = v; });
  wrap.innerHTML = '';
  for(let i=0;i<playerCount;i++){
    const f = document.createElement('div');
    f.className = 'name-field';
    f.innerHTML = `<span class="av" style="background:${PLAYER_COLORS[i]}">${AVATARS[i]}</span><input maxlength="12" placeholder="ชื่อผู้เล่น ${i+1}">`;
    const input = f.querySelector('input');
    input.value = savedNames[i] || `ผู้เล่น ${i+1}`;
    wrap.appendChild(f);
  }
}
function setPlayerCount(n){
  playerCount = n;
  document.querySelectorAll('.cnt').forEach(b=>{
    b.classList.toggle('on', +b.dataset.n === n);
  });
  renderNameInputs();
}
function readNames(){
  const vals = [...$('nameInputs').querySelectorAll('input')].map((inp,i)=>{
    const v = inp.value.trim();
    return v || `ผู้เล่น ${i+1}`;
  });
  return vals;
}

/* ---------- หน้าความรู้ ---------- */
let knowFrom = 'start';
function openKnowledge(from){
  knowFrom = from;
  const active = state && !state.over;
  $('btnKnowBack').textContent = active ? '🎮 กลับไปเล่นเกม' : '🎮 ไปเล่นเกม';
  showScreen('know');
}
function closeKnowledge(){
  if(state && !state.over) showScreen('game');
  else showScreen('setup');
}

/* ---------- โมดัลวิธีเล่น ---------- */
function openHow(){ $('howModal').hidden = false; }
function closeHow(){ $('howModal').hidden = true; }

/* ---------- เริ่มเกมใหม่ ---------- */
function resetToSetup(){
  if(state && !state.over){
    if(!confirm('ต้องการเริ่มเกมใหม่หรือไม่? ความคืบหน้าปัจจุบันจะหายไป')) return;
  }
  state = null;
  $('qModal').hidden = true;
  $('banner').classList.remove('show');
  showScreen('setup');
  renderNameInputs();
}

/* ---------- เชื่อมปุ่มทั้งหมด ---------- */
function bindEvents(){
  // หน้าแรก
  $('btnPlay').addEventListener('click', ()=>{
    if(!state || state.over){ setPlayerCount(playerCount); }
    showScreen('setup');
    renderNameInputs();
  });
  $('btnHowStart').addEventListener('click', openHow);
  $('btnKnowStart').addEventListener('click', ()=>openKnowledge('start'));
  $('btnSoundStart').addEventListener('click', toggleSound);

  // ตั้งค่าผู้เล่น
  document.querySelectorAll('.cnt').forEach(b=>{
    b.addEventListener('click', ()=>setPlayerCount(+b.dataset.n));
  });
  $('btnSetupBack').addEventListener('click', ()=>showScreen('start'));
  $('btnStart').addEventListener('click', ()=>{
    const names = readNames();
    startGame(names);
  });

  // หน้าความรู้
  $('btnKnowBack').addEventListener('click', closeKnowledge);

  // หน้าเกม
  $('btnRoll').addEventListener('click', onRoll);
  $('btnHowGame').addEventListener('click', openHow);
  $('btnKnowGame').addEventListener('click', ()=>openKnowledge('game'));
  $('btnSoundGame').addEventListener('click', toggleSound);
  $('btnNewGame').addEventListener('click', resetToSetup);

  // หน้าชนะ
  $('btnPlayAgain').addEventListener('click', ()=>{
    startGame(savedNames.slice(0, playerCount).map((n,i)=>n));
  });
  $('btnToStart').addEventListener('click', ()=>{
    state = null;
    showScreen('start');
  });

  // โมดัลวิธีเล่น
  $('btnHowClose').addEventListener('click', closeHow);
  $('howModal').addEventListener('click', e=>{ if(e.target.id === 'howModal') closeHow(); });
}

/* ---------- เริ่มต้นระบบ ---------- */
function init(){
  buildBoard();
  drawOverlay();
  setDice(1);
  updateSoundButtons();
  renderNameInputs();
  bindEvents();
}
document.addEventListener('DOMContentLoaded', init);
</script>
